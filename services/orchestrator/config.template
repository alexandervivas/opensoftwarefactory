# Workflow configuration. Saved by the orchestrator web UI, which does not keep comments.
#
# The seeded workflows are the exercises of the Software Factory course, one per session
# (ex01 to ex09). Their agents and policies are the group `course` in services/registry/seed.
#
# Each step runs on the Temporal task queue named by `service`. Steps without
# depends_on receive the run input; other steps receive the outputs of their
# dependencies as an ordered list of items. These services are special:
#   agent  runs the pinned agent named by `agent` (for example course/intake@v1)
#   gate   waits until a person approves or rejects in the factory UI
#   route  starts the workflow named in the `route` field of its input artifact
#   interactive  holds the step while a person works with its agents in a chat session
#   workflow     runs the workflow version named by `workflow` (for example build@v1) as
#                a child run; its output is the output of that workflow's single final step
#   team   a lead agent (`agent`) and other members (`agents`, `workflows`) exchange messages
#          over `channels` until the lead finishes the team; a gate with `on_reject` sends a
#          rejection and its reason back to the named team step and reopens afterwards
#   merge  waits until every step in `depends_on` has delivered and forwards their results
#          together; `capacity` (default 16) limits the waiting entries, and the run fails when
#          an entry stays incomplete for `input_timeout` seconds (default 300)
#   batch  collects results from the steps in `depends_on` and forwards them together once it
#          holds `size` items, or fewer once `input_timeout` seconds (default 300) have passed
#          since the last one
# The steps after a merge or batch run once per forwarded message; pass n of a step stores
# its artifact as runs/<trace>/<step>.pass-<n>.
# Steps of a routed workflow store their artifacts under runs/<trace>/<route step>/.
#
# The file keeps every version of every workflow: saving a workflow adds an entry with the
# next `version`. An entry without a version is v1. Workflow references pin a version
# (name@vN); a reference without one is pinned to the newest version when the file is loaded.
workflows:
  - name: ex01-team-standing
    description: "Session 1 exercise, Where Does Your Team Stand: fill in the worksheet in a chat and get a summary of the chosen practice."
    steps:
      - id: worksheet
        service: interactive
        agent: course/standing-coach@v1
        position:
          x: 260
          y: 30
      - id: summary
        service: agent
        agent: course/standing-summary@v1
        timeout: 10m
        depends_on:
          - worksheet
        position:
          x: 528
          y: 30
  - name: ex02-research-workflow
    description: "Session 2 exercise, Build a Research Workflow: plan a research question, research two sub-questions in parallel, and write one report for a person to accept."
    steps:
      - id: plan
        service: agent
        agent: course/research-planner@v1
        timeout: 10m
        position:
          x: 260
          y: 98
      - id: research-a
        service: agent
        agent: course/researcher@v1
        timeout: 10m
        depends_on:
          - plan
        position:
          x: 528
          y: 30
      - id: research-b
        service: agent
        agent: course/researcher@v1
        timeout: 10m
        depends_on:
          - plan
        position:
          x: 528
          y: 166
      - id: collect
        service: merge
        depends_on:
          - research-a
          - research-b
        input_timeout: 1800
        position:
          x: 796
          y: 98
      - id: report
        service: agent
        agent: course/research-writer@v1
        timeout: 10m
        depends_on:
          - collect
        position:
          x: 1064
          y: 98
      - id: decide
        service: gate
        on_reject: report
        question: Is the research report good enough to use? A rejection needs a reason.
        depends_on:
          - report
        position:
          x: 1332
          y: 98
  - name: ex03-system-design
    description: "Session 3 exercise, System Design for Your Own Software Factory: design the services with their requirements and approvals, and check the design."
    steps:
      - id: design
        service: agent
        agent: course/factory-architect@v1
        timeout: 10m
        position:
          x: 260
          y: 30
      - id: check
        service: agent
        agent: course/design-checker@v1
        timeout: 10m
        depends_on:
          - design
        position:
          x: 528
          y: 30
      - id: decide
        service: gate
        on_reject: design
        question: Does the checked design describe the factory you want to build?
        depends_on:
          - check
        position:
          x: 796
          y: 30
  - name: ex04-intake-triage
    description: "Session 4 exercise, Intake and Triage: run the intake checks on a signal, triage the work item by the routing rules, and confirm the triage."
    steps:
      - id: intake
        service: agent
        agent: course/intake@v1
        timeout: 10m
        position:
          x: 260
          y: 30
      - id: triage
        service: agent
        agent: course/triage@v1
        timeout: 10m
        depends_on:
          - intake
        position:
          x: 528
          y: 30
      - id: confirm
        service: gate
        on_reject: triage
        question: Is the triage correct, and may the work item go to the proposed next owner?
        depends_on:
          - triage
        position:
          x: 796
          y: 30
  - name: ex05-architecture-review
    description: "Session 5 exercise, An Architecture Review Agent: review a spec against the current ADRs and the spec policy, and decide on the findings."
    steps:
      - id: review
        service: agent
        agent: course/architecture-reviewer@v1
        timeout: 10m
        position:
          x: 260
          y: 30
      - id: decide
        service: gate
        on_reject: review
        question: Do you accept the reviewer's findings and their decisions for this spec?
        depends_on:
          - review
        position:
          x: 528
          y: 30
  - name: ex06-implementation
    description: "Session 6 exercise: an agent builds requirement R4 in a dev pod, the checks run, and the result is delivered as a pull request."
    steps:
      - id: pod
        service: devpod
        repository: claims-build
        source_branch: main
        work_branch: agent/payment-date-{run}
        protected:
          - tests/**
          - src/claims_system.py
          - verify.sh
          - run.sh
        position:
          x: 260
          y: 30
      - id: baseline
        service: command
        command: ./verify.sh
        allow_failure: true
        timeout: 2m
        depends_on:
          - pod
        position:
          x: 260
          y: 166
      - id: build
        service: agent
        agent: course/feature-builder@v1
        timeout: 20m
        depends_on:
          - baseline
        position:
          x: 260
          y: 302
      - id: verify
        service: command
        command: ./verify.sh
        timeout: 2m
        depends_on:
          - build
        position:
          x: 260
          y: 438
      - id: deliver
        service: agent
        agent: course/delivery-agent@v1
        timeout: 10m
        depends_on:
          - build
          - verify
        position:
          x: 260
          y: 574
      - id: decide
        service: gate
        question: Do you accept this pull request for R4? A rejection needs a reason and goes back to the builder.
        on_reject: build
        depends_on:
          - deliver
        position:
          x: 260
          y: 710
  - name: ex07-guardrails
    description: "Session 7 exercise: an agent fixes the incident while a rule blocks the forbidden text of CL-7, and the handover script rejects a change made through the shell."
    steps:
      - id: pod
        service: devpod
        repository: claims-portal
        source_branch: main
        work_branch: agent/incident-{run}
        protected:
          - checks/**
          - handover.sh
          - policies/**
        rules:
          - tool: write_file
            path: src/panel.py
            matches: rejection.?reason
            message: 'Blocked by CL-7: this portal panel may not show why a claim was rejected. Show "Rejected. Call your claims handler:" and the phone number of the claims handler instead.'
          - tool: edit_file
            path: src/panel.py
            matches: rejection.?reason
            message: 'Blocked by CL-7: this portal panel may not show why a claim was rejected. Show "Rejected. Call your claims handler:" and the phone number of the claims handler instead.'
        position:
          x: 260
          y: 30
      - id: fix
        service: agent
        agent: course/incident-fixer@v1
        timeout: 20m
        depends_on:
          - pod
        position:
          x: 260
          y: 166
      - id: handover
        service: command
        command: ./handover.sh
        timeout: 2m
        depends_on:
          - fix
        position:
          x: 260
          y: 302
      - id: tamper-with-check
        service: command
        command: echo "print('ok')" > checks/check_cl7.py
        allow_failure: true
        timeout: 2m
        depends_on:
          - handover
        position:
          x: 260
          y: 438
      - id: shell-change
        service: command
        command: |-
          cat > src/panel.py <<'PY'
          import sys

          from src.claims_system import get_claim


          def status_panel(claim_id):
              claim = get_claim(claim_id)
              if claim["status"] == "Rejected":
                  return "Rejected: " + claim["rejection_reason"]
              return claim["status"] + "."


          if __name__ == "__main__":
              print(status_panel(int(sys.argv[1])))
          PY
          ./panel.sh 2042
        allow_failure: true
        timeout: 2m
        depends_on:
          - tamper-with-check
        position:
          x: 260
          y: 574
      - id: handover-again
        service: command
        command: ./handover.sh
        allow_failure: true
        timeout: 2m
        depends_on:
          - shell-change
        position:
          x: 260
          y: 710
      - id: decide
        service: gate
        question: Did each guardrail stop what it should? The handover after the fix must accept, and the handover after the shell change must reject.
        depends_on:
          - handover-again
        position:
          x: 260
          y: 846
  - name: ex08-pr-review
    description: "Session 8 exercise: five specialized review agents check a pull request, and a dossier goes to the person who decides."
    steps:
      - id: spec-review
        service: agent
        agent: course/spec-agent@v1
        timeout: 10m
        position:
          x: 0
          y: 30
      - id: test-review
        service: agent
        agent: course/test-agent@v1
        timeout: 10m
        position:
          x: 268
          y: 30
      - id: code-review
        service: agent
        agent: course/code-agent@v1
        timeout: 10m
        position:
          x: 536
          y: 30
      - id: security-review
        service: agent
        agent: course/security-agent@v1
        timeout: 10m
        position:
          x: 804
          y: 30
      - id: qa-review
        service: agent
        agent: course/qa-agent@v1
        timeout: 10m
        position:
          x: 1072
          y: 30
      - id: collect
        service: merge
        input_timeout: 1800
        depends_on:
          - spec-review
          - test-review
          - code-review
          - security-review
          - qa-review
        position:
          x: 536
          y: 166
      - id: dossier
        service: agent
        agent: course/dossier-writer@v1
        timeout: 10m
        depends_on:
          - collect
        position:
          x: 536
          y: 302
      - id: decide
        service: gate
        question: What do you decide about this pull request? A rejection needs a reason and goes back to the dossier writer.
        on_reject: dossier
        depends_on:
          - dossier
        position:
          x: 536
          y: 438
  - name: ex09-trust-runs
    description: "Session 9 exercise, Would You Trust These Agent Runs: label agent runs from their records and propose one check for a failure found."
    steps:
      - id: label
        service: agent
        agent: course/run-reviewer@v1
        timeout: 10m
        position:
          x: 260
          y: 30
      - id: check
        service: agent
        agent: course/check-author@v1
        timeout: 10m
        depends_on:
          - label
        position:
          x: 528
          y: 30
      - id: decide
        service: gate
        on_reject: check
        question: Would you add the proposed check to the factory?
        depends_on:
          - check
        position:
          x: 796
          y: 30

# A schedule starts a workflow on a cron expression (5 fields, read in `timezone`, UTC by
# default) with the stored artifact `input` as the run input. `workflow` is a name or name@vN.
# `catchup_window` (default 24h, "0" for none) is how late a missed fire may still start.
# The input artifact must exist before the schedule is unpaused.
schedules:
  - name: weekly-architecture-review
    workflow: ex05-architecture-review@v1
    input: tasks/weekly-architecture-review.md
    cron: "0 9 * * 1"
    paused: true
